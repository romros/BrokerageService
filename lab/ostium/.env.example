# Ostium SDK Configuration

# REQUIRED: Your wallet private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# REQUIRED: RPC URL for Arbitrum Sepolia testnet
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Safety flags (must be set to 1 for testnet trading)
E2E_TESTNET=1
ENABLE_LIVE_TRADING=1
