# Lighter API Configuration

# API Key private key (generate at app.lighter.xyz)
API_KEY_PRIVATE_KEY=your_api_key_private_key_here

# API Key index (3-254, default is 3)
API_KEY_INDEX=3

# Account index (leave empty to auto-detect)
ACCOUNT_INDEX=

# Network (testnet or mainnet)
NETWORK=testnet

# WebSocket URL
WS_URL=wss://testnet.zklighter.elliot.ai/stream

# Your wallet address (for account lookup)
WALLET_ADDRESS=your_wallet_address_here

# Orderbook ID for testing (1 = ETH/USDC on testnet)
ORDER_BOOK_ID=1
