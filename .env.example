# ============================================================
# BrokerageService - Arbitrum Sepolia Testnet Configuration
# ============================================================
#
# ✅ TESTNET PRACTICE MODE:
#    This configuration uses Arbitrum Sepolia testnet with real gTrade contracts.
#    Benefits:
#    - Real gTrade contracts (GNSMultiCollatDiamond)
#    - Real blockchain transactions (testnet, no real money)
#    - Real backend integration (backend-sepolia.gains.trade)
#    - Practice DAI tokens available (10,000 DAI free from platform)
#    - Zero risk - testnet only
#
# 📋 SETUP INSTRUCTIONS:
#
#    1. Get testnet ETH from faucet:
#       https://arbitrum.io/bridge
#
#    2. Get practice GNS_USDC tokens (10,000 free):
#       https://gains.trade/ → Switch to Practice Mode → Claim tokens
#       Note: Sepolia uses GNS_USDC (0x4cC7...cD6), not standard USDC
#
#    3. Copy this file to .env:
#       cp .env.example .env
#
#    4. Edit .env and add your seed phrase (12 words):
#       WALLET_MNEMONIC="your twelve word seed phrase here"
#
#    5. Run connection test:
#       ./test.sh verify_testnet_contracts.py
#
# ============================================================

# ============ MODE ============
MODE=paper

# ============ VENUE ============
VENUE=gtrade

# ============ STORAGE ============
DATAFILES_ROOT=/datafiles
CANONICAL_TZ=America/New_York
SYMBOLS=XAUUSD,EURUSD

# ============ SYMBOL FALLBACK (Market Status Gate) ============
# If primary symbol is closed (e.g., XAUUSD on weekend), try fallback symbols
# PRIMARY_SYMBOLS: Preferred symbols to trade (in priority order)
# FALLBACK_SYMBOLS: Backup symbols if primary closed (typically 24/7 crypto pairs)
PRIMARY_SYMBOLS=EURUSD,XAUUSD
FALLBACK_SYMBOLS=BTCUSD

# ============ BACKFILL ============
BACKFILL_INTERVAL_SECONDS=600
CORRECTIVE_WINDOW_MINUTES=5

# ============ API ============
HOST=0.0.0.0
PORT=8000

# ============ LOGGING ============
LOG_LEVEL=INFO
LOG_DIR=logs

# ============================================================
# Blockchain Configuration (Arbitrum Sepolia Testnet)
# ============================================================

# RPC URL (Arbitrum Sepolia)
ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_CHAIN_ID=421614

# Wallet Configuration
# ⚠️  ADD YOUR SEED PHRASE HERE (12 words from your wallet)
WALLET_ADDRESS=0xD9fC17C093614D20976EFb1535A7142081A031b2
WALLET_MNEMONIC=
WALLET_DERIVATION_PATH=m/44'/60'/0'/0/0

# gTrade Contracts (Arbitrum Sepolia Testnet)
GTRADE_DIAMOND_ADDRESS=0xd659a15812064C79E189fd950A189b15c75d3186
GTRADE_TRADING_ADDRESS=0xd659a15812064C79E189fd950A189b15c75d3186
USDC_TOKEN_ADDRESS=0x4cC7EbEeD5EA3adf3978F19833d2E1f3e8980cD6

# WebSocket Price Feed (Live market data - same as mainnet)
GTRADE_PRICE_WS_URL=wss://feed-gtrade-arb.gainsnetwork.io/ws
ENABLE_LIVE_FEED=1
LIVE_TICKER_BROADCAST_MS=200

# Backend REST API (Sepolia testnet backend)
GTRADE_BACKEND_REST_URL=https://backend-sepolia.gains.trade

# Live mode flags
ENABLE_LIVE_TRADING=1
ENABLE_LIVE_READONLY=1

# ============ E2E TESTING (Real Testnet Transactions) ============
# E2E smoke tests execute REAL blockchain transactions on Arbitrum Sepolia
# These tests are MANUAL/SLOW and not run in CI by default
#
# Safety guards:
# - E2E_TESTNET=1 required (confirms intent to run testnet transactions)
# - ENABLE_LIVE_TRADING=1 required (enables transaction execution)
# - Chain ID verified (must be 421614, aborts on mainnet)
# - Collateral limits enforced
#
# Usage:
#   E2E_TESTNET=1 ENABLE_LIVE_TRADING=1 ./test.sh scripts/testnet_e2e_smoke.py
#   E2E_TESTNET=1 ENABLE_LIVE_TRADING=1 pytest testing/e2e/ -v -s
#
E2E_TESTNET=0
MAX_COLLATERAL_USDC=200.0

# ============================================
# Backtest Configuration (Not used in fork mode)
# ============================================
# BACKTEST_START_DATE=2024-01-01T00:00:00
# BACKTEST_END_DATE=2024-12-31T23:59:59
# BACKTEST_SPEED=1000
# BACKTEST_INITIAL_BALANCE=10000

# ============================================
# Paper Trading Configuration
# ============================================
PAPER_INITIAL_BALANCE=10000
PAPER_SLIPPAGE_PERCENT=0.1
PAPER_FEE_PERCENT=0.05

# ============================================================
# Lighter L3 Configuration (Testnet)
# ============================================================
# Lighter is a L3 ZK-rollup perpetual DEX with:
# - 0% protocol fees (gas only: ~$0.16/RT)
# - HTTP SDK (not EVM RPC)
# - Two-key authentication (L1 wallet + API trading key)
#
# Lab validation: lab/lighter/LIGHTER_COMPLETE_VALIDATION.md
# Testnet UI: https://testnet.app.lighter.xyz
#
# CRITICAL: account_index and api_key_index MUST match between
# registration and signing. Never mix keys across environments.

# API endpoint (testnet)
LIGHTER_BASE_URL=https://testnet.zklighter.elliot.ai

# L1 wallet (for API key registration only)
LIGHTER_L1_ADDRESS=0x...
LIGHTER_L1_PRIVATE_KEY=  # 64 hex chars (standard Ethereum key)

# Account and API key indices (must be consistent)
LIGHTER_ACCOUNT_INDEX=210
LIGHTER_API_KEY_INDEX=1

# API trading key (for order signing only)
LIGHTER_API_PRIVATE_KEY=  # 80 hex chars (Lighter-specific key)

# ============================================================
# Ostium Configuration (Arbitrum Sepolia Testnet)
# ============================================================
# Ostium uses same network and wallet as gTrade
# RPC_URL and PRIVATE_KEY are shared configuration

# Ostium-specific settings
OSTIUM_NETWORK=testnet
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Wallet (use same as gTrade or separate for isolation)
PRIVATE_KEY=

# Safety flags (testnet operations)
E2E_TESTNET=1
ENABLE_LIVE_TRADING=1
