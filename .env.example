# ============================================================
# BrokerageService - Arbitrum Sepolia Testnet Configuration
# ============================================================
# Còpia: cp .env.example .env
# Secrets: copia .env.secrets.example → .env.secrets i omple els valors (no comitis .env ni .env.secrets)

# ============ MODE ============
MODE=paper

# ============ VENUE ============
VENUE=gtrade

# ============ STORAGE ============
DATAFILES_ROOT=/datafiles
CANONICAL_TZ=America/New_York
SYMBOLS=XAUUSD,EURUSD

# ============ BACKFILL ============
BACKFILL_INTERVAL_SECONDS=600
CORRECTIVE_WINDOW_MINUTES=5

# ============ API ============
# Aquest PORT és l'API del servei; el gateway nginx va per 8081 (si s'usa l'stack split).
HOST=0.0.0.0
PORT=8000

# ============ LOGGING ============
LOG_LEVEL=INFO
LOG_DIR=logs

# ============================================================
# Blockchain Configuration (Arbitrum Sepolia Testnet)
# ============================================================

ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_CHAIN_ID=421614

# Wallet (adreça pública; el mnemonic va a .env.secrets)
WALLET_ADDRESS=0xREPLACE_WITH_YOUR_ADDRESS
WALLET_DERIVATION_PATH=m/44'/60'/0'/0/0

# gTrade Contracts (Arbitrum Sepolia Testnet)
GTRADE_DIAMOND_ADDRESS=0xd659a15812064C79E189fd950A189b15c75d3186
GTRADE_TRADING_ADDRESS=0xd659a15812064C79E189fd950A189b15c75d3186
USDC_TOKEN_ADDRESS=0x4cC7EbEeD5EA3adf3978F19833d2E1f3e8980cD6

GTRADE_PRICE_WS_URL=wss://feed-gtrade-arb.gainsnetwork.io/ws
ENABLE_LIVE_FEED=1
LIVE_TICKER_BROADCAST_MS=200

GTRADE_BACKEND_REST_URL=https://backend-sepolia.gains.trade

ENABLE_LIVE_TRADING=1
ENABLE_LIVE_READONLY=1

# ============================================
# Paper Trading Configuration
# ============================================
PAPER_INITIAL_BALANCE=10000
PAPER_SLIPPAGE_PERCENT=0.1
PAPER_FEE_PERCENT=0.05

E2E_TESTNET=1
MAX_COLLATERAL_USDC=10.0

# Ostium (PRIVATE_KEY va a .env.secrets)
# Nota: els network smokes d'Ostium poden esperar OSTIUM_RPC_URL si no hi ha alias; RPC_URL és la variable del projecte.
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# ============================================
# Lighter Configuration (testnet)
# ============================================
LIGHTER_BASE_URL=https://testnet.zklighter.elliot.ai
LIGHTER_L1_ADDRESS=0xREPLACE_WITH_YOUR_ADDRESS
LIGHTER_ACCOUNT_INDEX=210
LIGHTER_API_KEY_INDEX=1
# LIGHTER_L1_PRIVATE_KEY i LIGHTER_API_PRIVATE_KEY a .env.secrets

# --- Quality Gate (trading_service split) ---
QUALITY_GATE_MIN_COMPLETENESS=0.90
QUALITY_GATE_MAX_FRESHNESS_SEC=300
QUALITY_GATE_MAX_GAP_S_GATE=180
DATA_QUALITY_MAX_MISSING_MINUTES=1
